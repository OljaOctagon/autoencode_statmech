# ============================================================
# Lennard-Jones FCC crystal
# Pressure-driven melting by decompression
#
# Protocol:
#   1. Create FCC crystal at initial rho* = 1.2
#   2. Minimize the crystal
#   3. Initialize velocities at T* = 1.0
#   4. Equilibrate at T* = 1.0 and P* = 8.0
#   5. Slowly decrease pressure from P* = 8.0 to P* = 1.0
#   6. Monitor density, energy and Q6 during melting
#
# Reduced Lennard-Jones units:
#   epsilon = 1
#   sigma   = 1
#   mass    = 1
# ============================================================


# ============================================================
# 1. INITIALIZATION
# ============================================================

clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:98)
  using 1 OpenMP thread(s) per MPI task

units           lj
dimension       3
boundary        p p p
atom_style      atomic

timestep        0.005


# ============================================================
# 2. INTERACTION STYLE
# ============================================================

pair_style      lj/cut 2.5


# ============================================================
# 3. CREATE FCC CRYSTAL
# ============================================================

# For "units lj":
#
# lattice fcc 1.2
#
# means an FCC lattice with reduced number density rho* = 1.2.

lattice         fcc 1.2                                  orient x 1 0 0                           orient y 0 1 0                           orient z 0 0 1
Lattice spacing in x,y,z = 1.4938016 1.4938016 1.4938016


# Number of conventional FCC unit cells in each direction

variable        nx equal 10
variable        ny equal 10
variable        nz equal 10


# Create simulation box

region          box block                                0 ${nx}                                  0 ${ny}                                  0 ${nz}                                  units lattice
region          box block                                0 10                                  0 ${ny}                                  0 ${nz}                                  units lattice
region          box block                                0 10                                  0 10                                  0 ${nz}                                  units lattice
region          box block                                0 10                                  0 10                                  0 10                                  units lattice

create_box      1 box
Created orthogonal box = (0 0 0) to (14.938016 14.938016 14.938016)
  1 by 1 by 1 MPI processor grid

create_atoms    1 box
Created 4000 atoms
  using lattice units in orthogonal box = (0 0 0) to (14.938016 14.938016 14.938016)
  create_atoms CPU = 0.001 seconds


# ============================================================
# 4. MASS AND LJ PARAMETERS
# ============================================================

# These commands MUST come after create_box

mass            1 1.0

# pair_coeff:
# atom types = 1 1
# epsilon = 1.0
# sigma   = 1.0

pair_coeff      1 1 1.0 1.0


# ============================================================
# 5. NEIGHBOR LIST SETTINGS
# ============================================================

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes


# ============================================================
# 6. ENERGY MINIMIZATION
# ============================================================

thermo          100

thermo_style    custom                                  step                                    atoms                                   temp                                    press                                   pe                                      etotal                                  vol                                     density


min_style       cg

minimize        1.0e-8 1.0e-10 10000 100000
