# Start MD timestep numbering from zero after minimization

reset_timestep  0


# ============================================================
# 7. INITIAL VELOCITIES
# ============================================================

# Generate velocities corresponding to T* = 1.0
#
# Random seed = 10917

velocity        all create 1.0 10917                     mom yes                                  rot no                                   dist gaussian


# ============================================================
# 8. STRUCTURAL OBSERVABLES
# ============================================================

# Per-atom potential energy

compute         poteng all pe/atom


# Steinhardt Q6 bond-orientational order parameter
#
# Use the 12 nearest neighbors.
#
# For a well ordered FCC structure Q6 should be relatively high.
# In the liquid Q6 should decrease significantly.

compute         orient all orientorder/atom                     degrees 1 6                                     nnn 12                                          cutoff 2.0


# Average Q6 over all atoms

compute         Q6 all reduce ave c_orient[1]


# ============================================================
# 9. VARIABLES FOR OUTPUT
# ============================================================

variable        temperature equal temp
variable        pressure    equal press
variable        potential   equal pe
variable        volume      equal vol
variable        rho         equal density


# ============================================================
# 10. THERMODYNAMIC OUTPUT
# ============================================================

thermo          1000

thermo_style    custom                                  step                                    temp                                    press                                   pe                                      ke                                      etotal                                  vol                                     density                                 c_Q6


# ============================================================
# 11. WRITE OBSERVABLES TO FILE
# ============================================================

# Average over 10 measurements:
#
# sample every 100 timesteps
# write every 1000 timesteps
#
# Columns in melting_observables.dat:
#
# timestep
# T*
# P*
# PE
# volume
# density
# Q6

fix             observables all ave/time                        100 10 1000                                     v_temperature                                    v_pressure                                       v_potential                                      v_volume                                         v_rho                                            c_Q6                                             file melting_observables.dat


# ============================================================
# 12. TRAJECTORY OUTPUT
# ============================================================

# Save one configuration every 1000 timesteps.
#
# The trajectory contains:
#   atom ID
#   atom type
#   position
#   velocity
#   per-atom potential energy
#   per-atom Q6

dump            trajectory all custom 1000                      melting.lammpstrj                                id                                               type                                             x y z                                            vx vy vz                                         c_poteng                                         c_orient[1]

dump_modify     trajectory sort id pbc yes


# ============================================================
# 13. EQUILIBRATION OF FCC CRYSTAL
# ============================================================

print "======================================================"
======================================================
print "FCC EQUILIBRATION"
FCC EQUILIBRATION
print "T* = 1.0"
T* = 1.0
print "P* = 8.0"
P* = 8.0
print "======================================================"
======================================================


# NPT simulation:
#
# Temperature:
#     T* = 1.0
#
# Pressure:
#     P* = 8.0
#
# Tdamp = 1.0
# Pdamp = 10.0
#
# "iso" means that the box changes isotropically.

fix             equil all npt                                   temp 1.0 1.0 1.0                                iso  8.0 8.0 10.0


# Equilibration:
#
# 200000 steps * 0.005 = 1000 LJ time units

run             200000
