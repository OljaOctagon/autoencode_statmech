
units           lj
dimension       3
boundary        p p p
atom_style      atomic
timestep        0.005

pair_style      lj/cut 2.5

# Keep these as index variables so short smoke tests can override
# them with: lmp -var equil_steps 0 -var ramp_steps 0 -in in.lj
variable        equil_steps index 200000
variable        ramp_steps  index 1000000

# Ideal HCP cell at the same initial number density as the FCC run.
lattice         hcp 1.2                                  orient x 1 0 0                           orient y 0 1 0                           orient z 0 0 1
Lattice spacing in x,y,z = 1.0562772 1.8295258 1.7248935

variable        nx equal 10
variable        ny equal 10
variable        nz equal 10
region          box block 0 ${nx} 0 ${ny} 0 ${nz} units lattice
region          box block 0 10 0 ${ny} 0 ${nz} units lattice
region          box block 0 10 0 10 0 ${nz} units lattice
region          box block 0 10 0 10 0 10 units lattice
create_box      1 box
Created orthogonal box = (0 0 0) to (10.562772 18.295258 17.248935)
  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 4000 atoms
  using lattice units in orthogonal box = (0 0 0) to (10.562772 18.295258 17.248935)
  create_atoms CPU = 0.001 seconds

mass            1 1.0
pair_coeff      1 1 1.0 1.0

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

# Relax the ideal lattice, then make the production timeline start at zero.
thermo          100
thermo_style    custom step atoms temp press pe etotal vol density
min_style       cg
minimize        1.0e-8 1.0e-10 10000 100000
